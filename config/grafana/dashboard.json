{
  "__inputs": [],
  "__requires": [],
  "annotations": { "list": [] },
  "description": "EcoTrack API — four golden signals: latency, traffic, errors, saturation",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 10,
      "title": "Latency",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "list" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(http_server_requests_seconds_bucket{job='ecotrack-app'}[5m]))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(http_server_requests_seconds_bucket{job='ecotrack-app'}[5m]))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(http_server_requests_seconds_bucket{job='ecotrack-app'}[5m]))",
          "legendFormat": "p99"
        }
      ],
      "title": "Request Latency (p50 / p95 / p99)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 11,
      "title": "Traffic",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 2,
      "targets": [
        {
          "expr": "rate(http_server_requests_seconds_count{job='ecotrack-app'}[5m])",
          "legendFormat": "{{ method }} {{ uri }}"
        }
      ],
      "title": "Request Rate (req/s)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 12,
      "title": "Errors",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "percentunit", "max": 1 }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "id": 3,
      "targets": [
        {
          "expr": "rate(http_server_requests_seconds_count{job='ecotrack-app',status=~'5..'}[5m]) / rate(http_server_requests_seconds_count{job='ecotrack-app'}[5m])",
          "legendFormat": "Error rate"
        }
      ],
      "title": "Error Rate (5xx)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "id": 13,
      "title": "Saturation",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "percentunit", "max": 1 }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "id": 4,
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{job='ecotrack-app',area='heap'} / jvm_memory_max_bytes{job='ecotrack-app',area='heap'}",
          "legendFormat": "Heap"
        }
      ],
      "title": "JVM Heap Saturation",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "id": 5,
      "targets": [
        {
          "expr": "hikaricp_connections_active{job='ecotrack-app'}",
          "legendFormat": "Active"
        },
        {
          "expr": "hikaricp_connections_pending{job='ecotrack-app'}",
          "legendFormat": "Pending"
        },
        {
          "expr": "hikaricp_connections{job='ecotrack-app'}",
          "legendFormat": "Total"
        }
      ],
      "title": "DB Connection Pool",
      "type": "timeseries"
    }
  ],
  "schemaVersion": 38,
  "tags": ["ecotrack", "spring-boot"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      }
    ]
  },
  "title": "EcoTrack API",
  "uid": "ecotrack-api",
  "version": 1
}
