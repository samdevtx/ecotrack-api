<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

    <!--
        DOMPurify mXSS CVEs bundled inside swagger-ui (via springdoc-openapi).
        Swagger UI is served at /swagger-ui.html — a developer-only endpoint, not
        accessible to end users. The mXSS vector requires attacker-controlled HTML
        to be re-inserted into a new parsing context via innerHTML with special wrappers
        (script, xmp, iframe, etc.). This API does not perform that operation; the
        Swagger UI only renders static OpenAPI spec content. Re-evaluate when a
        springdoc-openapi release ships with DOMPurify >= 3.3.2.
    -->
    <suppress>
        <notes>DOMPurify mXSS in swagger-ui only; Swagger UI is dev-only, not user-facing. Re-evaluate on springdoc upgrade.</notes>
        <cve>CVE-2026-0540</cve>
    </suppress>
    <suppress>
        <notes>DOMPurify mXSS in swagger-ui only; Swagger UI is dev-only, not user-facing. Re-evaluate on springdoc upgrade.</notes>
        <cve>CVE-2025-15599</cve>
    </suppress>

</suppressions>
